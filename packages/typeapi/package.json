{
  "name": "@antribute/typeapi",
  "description": "A completely typesafe backend framework",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "require": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "types": "./src/index.ts",
  "scripts": {
    "build": "bunx --bun unbuild",
    "clean": "rimraf .turbo && rimraf dist"
  },
  "keywords": [
    "antribute",
    "hono",
    "typeapi",
    "typebox"
  ],
  "author": "Antribute, Inc. (https://www.antribute.com)",
  "license": "MIT",
  "devDependencies": {
    "@antribute/config": "workspace:*",
    "@sinclair/typebox": "^0.32.13",
    "typescript": "^5.0.4",
    "unbuild": "^2.0.0"
  },
  "peerDependencies": {
    "@sinclair/typebox": ">= 0.32.13 < 1"
  },
  "dependencies": {
    "@hono/node-server": "^1.3.3",
    "consola": "^3.2.3",
    "hono": "^3.11.8"
  }
}
